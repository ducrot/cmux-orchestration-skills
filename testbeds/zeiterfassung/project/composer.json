{
    "name": "solo/time-tracker",
    "description": "Time tracking and invoicing for a solo developer",
    "type": "project",
    "require": {"php": "^8.3", "ext-pdo": "*", "ext-pdo_sqlite": "*"},
    "require-dev": {"phpunit/phpunit": "^11.5", "phpstan/phpstan": "^2.1"},
    "autoload": {"psr-4": {"TimeTracker\\": "src/"}},
    "autoload-dev": {"psr-4": {"TimeTracker\\Tests\\": "tests/"}},
    "scripts": {"test": "phpunit", "analyse": "phpstan analyse --no-progress"},
    "config": {"sort-packages": true, "platform": {"php": "8.3.0"}}
}
